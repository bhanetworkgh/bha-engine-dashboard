# Server environment for the BHA engine dashboard. Copy to .env for local use
# (never committed) or set each in the host's environment settings.
#
# The server reads these. Nothing here reaches the browser.

# Postgres. REQUIRED — the server prints why and exits if this is missing or
# the database is unreachable. There is no fallback store on purpose: one would
# accept writes it could not keep.
#
# On Render use the INTERNAL connection string for bha-engine-db: its host is a
# single label (dpg-...-a), it carries no TLS, and it only resolves from a
# service in the same region. The external host (....render.com) needs TLS; set
# DATABASE_CA_CERT to Render's published CA to have the certificate verified
# rather than merely used.
DATABASE_URL=postgres://user:password@localhost:5432/bha_engine
# DATABASE_CA_CERT=
# DATABASE_POOL_MAX=8

# Port the server listens on. Render sets PORT itself.
PORT=8787

# The shared team login. Produce the hash with:  npm run hash-password -- 'the password'
AUTH_EMAIL=admin@bhanetwork.org
AUTH_PASSWORD_HASH=scrypt$...$...
# Plain-text alternative for local development only. The hash wins when both are set.
# AUTH_PASSWORD=

# Signs the session cookie. Any long random string; when unset, a random key is
# generated at boot and every session ends on restart.
SESSION_SECRET=

# The Bays agent workflow and the key it expects in the x-api-key header.
ASK_BAYS_URL=https://n8n.arupiautomates.cloud/webhook/dashboard-ask-bays
ASK_BAYS_API_KEY=
ASK_BAYS_MODEL_LABEL=Claude Sonnet 5.0
