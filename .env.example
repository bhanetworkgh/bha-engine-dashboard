# Server environment for the BHA engine dashboard. Copy to .env for local use
# (never committed) or set each in the host's environment settings.
#
# The server reads these. Nothing here reaches the browser.

# Postgres. REQUIRED — the server prints why and exits if this is missing or
# the database is unreachable. There is no fallback store on purpose: one would
# accept writes it could not keep.
#
# On Render use the INTERNAL connection string for bha-engine-db: its host is a
# single label (dpg-...-a), it carries no TLS, and it only resolves from a
# service in the same region. The external host (....render.com) needs TLS; set
# DATABASE_CA_CERT to Render's published CA to have the certificate verified
# rather than merely used.
DATABASE_URL=postgres://user:password@localhost:5432/bha_engine
# DATABASE_CA_CERT=
# DATABASE_POOL_MAX=8

# Port the server listens on. Render sets PORT itself.
PORT=8787

# The shared team login. Produce the hash with:  npm run hash-password -- 'the password'
AUTH_EMAIL=admin@bhanetwork.org
AUTH_PASSWORD_HASH=scrypt$...$...
# Plain-text alternative for local development only. The hash wins when both are set.
# AUTH_PASSWORD=

# Signs the session cookie. Any long random string; when unset, a random key is
# generated at boot and every session ends on restart.
SESSION_SECRET=

# The Bays agent workflow and the key it expects in the x-api-key header.
ASK_BAYS_URL=https://bayshorizonnetwork.app.n8n.cloud/webhook/dashboard-ask-bays
ASK_BAYS_API_KEY=
ASK_BAYS_MODEL_LABEL=Claude Sonnet 5.0

# The n8n public API, for the Executions page (15 Sep 2026). READ ONLY — the two
# endpoints used are GET /api/v1/executions and GET /api/v1/workflows (the
# second for workflow names only), and nothing in this server can write to n8n.
#
# This is NOT the same credential as ASK_BAYS_API_KEY: that is the header a
# webhook expects, this is an instance API key (Settings → n8n API). Without it
# no execution is ever read and the Executions page says so rather than showing
# a zero.
#
# It has to be snapshotted because **n8n's execution history does not persist**:
# read on 15 Sep 2026 the instance held 3,673 executions and none older than the
# 12th. A monthly chart that asked the API about August would be told, honestly,
# that August held nothing.
N8N_API_KEY=
# Defaults to N8N_BASE_URL + /api/v1. Set this to point at a replay in a sandbox.
# N8N_API_URL=https://bayshorizonnetwork.app.n8n.cloud/api/v1

# The n8n instance the "view execution" links on fixture-backed rows point at.
# Defaults to the company instance. Execution ids recorded before the move off
# n8n.arupiautomates.cloud do not exist on it and will 404; that is known.
# N8N_BASE_URL=https://bayshorizonnetwork.app.n8n.cloud

# The engine's own service key. n8n sends it in x-dashboard-key on every write
# to /api/engine/*, and since the Airtable sync was removed (13 Sep 2026) that
# is the only way a record reaches this dashboard at all.
DASHBOARD_INBOUND_KEY=

# Loop and Codex edits go straight to Airtable (14 Sep 2026), replacing the n8n
# write-back that stood here for a day. Needs data.records:read and :write on
# BOTH bases below — Open Loops and BHA Submissions.
#
# It also needs data.records:READ on three more, for the resync button that
# Build patterns, Commercial and Clients gained on 15 Sep 2026:
#   app5ni3E8r7Lvxk22  Build Patterns
#   appvLglfdCqOKqLpT  Commercial Opportunities
#   appkSUSh9ijNjP2f8  BHA Client Research Loop
# Nothing is ever written to those three; they have no variable of their own
# because the dashboard never writes to them and so can never write to a guess.
# Without read on them the resync refuses, names the table and changes nothing —
# it never reads a refusal as an emptied table.
#
# This said "the Open Loops base and nothing else" until 14 Sep, and a token
# scoped that way authenticates fine and then refuses every read of the
# submissions base, which is what the Codex page's reconciliation hit.
#
# Note the name: the client deleted on 13 Sep read AIRTABLE_API_KEY. This reads
# AIRTABLE_TOKEN, which is the variable set on the service.
AIRTABLE_TOKEN=
# One variable per base, named for its base. There is no default for this one:
# a default is a guess about which base real loops are written to, and a wrong
# guess writes them into it rather than failing. Unset, the server says so by
# name at boot and refuses every loop edit with the same sentence.
# (It was AIRTABLE_BASE_ID until 14 Sep 2026; that name is read by nothing.)
AIRTABLE_OPEN_LOOPS_BASE_ID=appUVlBSGGPHw6DGh
# BHA Submissions & Logs, for Codex entries. The same token covers both bases.
AIRTABLE_SUBMISSIONS_BASE_ID=appEmdKshNVTl64Zf
# Point the same client at a local replay of the API in a sandbox.
# AIRTABLE_API_URL=https://api.airtable.com/v0
