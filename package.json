{
  "name": "bha-engine-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node --no-warnings=ExperimentalWarning server-dist/server/src/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('server-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "start": "node --no-warnings=ExperimentalWarning server-dist/server/src/index.js",
    "hash-password": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server-dist/server/src/hash.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:proposal": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/proposal.test.cjs",
    "test:stripe-ledger": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/stripe-ledger.test.cjs",
    "test:gate": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/write-gate.test.cjs",
    "test:lookup": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/lookup-shape.test.cjs",
    "test:pay": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/pay-sync.test.cjs",
    "test:recovery": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/recovery.test.cjs",
    "test:mcp-write": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/mcp-write.test.cjs",
    "test:bays-tools": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/bays-tools.test.cjs",
    "test:north-star": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/north-star-tools.test.cjs",
    "test:research-twin": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/research-twin-tools.test.cjs",
    "test:candidates": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/pattern-candidates.test.cjs",
    "test:airtable-sweep": "npm run build:server --silent && node server/test/airtable-sweep.test.cjs",
    "test:approvals": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/approvals.test.cjs",
    "test:monitoring-recurrence": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/monitoring-recurrence.test.cjs",
    "test:audio": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/audio-tools.test.cjs",
    "test:lane-ranking": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/lane-ranking.test.cjs",
    "test:client-report": "npm run build:server --silent && node server/test/client-report.test.cjs",
    "test:codex-reject": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/codex-reject.test.cjs",
    "test:un9d": "node --no-warnings=ExperimentalWarning server/test/un9d.test.cjs",
    "test:pattern-reingest": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/pattern-reingest.test.cjs",
    "test:move-loop": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/move-loop.test.cjs",
    "test:agent-inventory": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/agent-inventory.test.cjs",
    "test:n8n-mcp": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/n8n-mcp.test.cjs",
    "test:sops": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/sops.test.cjs",
    "test:pattern-capture": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/pattern-capture.test.cjs",
    "test:credit-out": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/credit-out.test.cjs",
    "test:logstream": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/logstream.test.cjs",
    "test:vfarm-customers": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/vfarm-customers.test.cjs",
    "test:twin-envelope": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/twin-envelope.test.cjs",
    "test:research-signals": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/research-signals.test.cjs",
    "test:draft-eval": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/draft-eval.test.cjs",
    "test:intake2": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/intake2.test.cjs",
    "test:decision-watch": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/decision-watch.test.cjs",
    "test:publish-gate": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/publish-gate.test.cjs",
    "test:scheduled-runs": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/scheduled-runs.test.cjs",
    "test:vfarm-gates": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/vfarm-gates.test.cjs && node --no-warnings=ExperimentalWarning server/test/vfarm-gate-auto.test.cjs",
    "test:t0no": "npm run build:server --silent && node server/test/t0no.test.cjs",
    "test:vrfk": "npm run build:server --silent && node server/test/publication-decision.test.cjs",
    "test:vrfk-db": "npm run build:server --silent && node server/test/publication-decision.db.test.cjs",
    "test:se8l": "npm run build:server --silent && node server/test/doctrine-gap.test.cjs",
    "test:eg4n": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/genie-doctrine.test.cjs",
    "test:se8l-db": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/doctrine-gap.db.test.cjs",
    "test:vrfk-http": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server/test/publication-decision.http.test.cjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
