{
  "name": "bha-engine-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node --no-warnings=ExperimentalWarning server-dist/server/src/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('server-dist/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "start": "node --no-warnings=ExperimentalWarning server-dist/server/src/index.js",
    "hash-password": "npm run build:server --silent && node --no-warnings=ExperimentalWarning server-dist/server/src/hash.js",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
